# La versión que funciona del modelo, revisada por una persona:
#  · dos etapas: el compilador se queda en la primera y no llega a la imagen final;
#  · en la final, solo la biblioteca de PostgreSQL que hace falta en tiempo de ejecución (libpq5);
#  · usuario sin privilegios; sin las listas de apt.
FROM python:3.10-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/instalado -r requirements.txt

FROM python:3.10-slim
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* && useradd --create-home app
COPY --from=build /instalado /usr/local
WORKDIR /app
COPY app.py .
USER app
EXPOSE 8080
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8080", "app:app"]
