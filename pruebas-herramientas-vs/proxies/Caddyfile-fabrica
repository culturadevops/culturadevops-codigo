# VARIANTE «de fábrica» del Caddyfile: reverse_proxy sin tocar el pool al backend. Solo para la prueba de 1.000 conexiones.
# Caddy 2.11 — lo mismo que nginx.conf: estático en /static/, proxy a backend:9000 en /api, HTTP en 8080 y HTTPS en 8443
# con el MISMO certificado (aquí no hay Let's Encrypt: es una red privada de Docker). GOMAXPROCS=2 en el contenedor.
{
	auto_https off
	admin off
}

(comun) {
	handle /static/* {
		root * /srv/www
		file_server
	}
	handle /api {
		reverse_proxy backend:9000
	}
}

http://:8080 {
	import comun
}

https://:8443 {
	tls /etc/certs/cert.pem /etc/certs/key.pem
	import comun
}
